# Turnint — environment configuration template.
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# `.env.example` is safe to commit because it contains placeholders only.

# =============================================================================
# Database
# =============================================================================
# Local development uses SQLite. For PostgreSQL set e.g.:
#   postgresql://user:password@localhost:5432/turnint?schema=public
DATABASE_URL="file:./dev.db"

# =============================================================================
# Authentication (next-auth v4)
# =============================================================================
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Base URL of this app. Required for correct callback URLs.
NEXTAUTH_URL="http://localhost:3000"
# Public application URL used for absolute links (emails, refunds, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Razorpay (sandbox — wired up in a later phase)
# =============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Exposed to the browser for Razorpay Checkout only (publishable key).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# =============================================================================
# Private document storage
# =============================================================================
# Only "local" is implemented. Documents are stored OUTSIDE /public and are
# reachable exclusively through authorized, ownership-checked routes.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./private-storage"
# Placeholders for a future S3-compatible driver (not implemented).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# =============================================================================
# Malware scanning
# =============================================================================
# Leave unset/"unconfigured" until a real scanner is wired up. With no scanner,
# every upload is held in QUARANTINE and can never be downloaded. Files are only
# marked AVAILABLE when an actual scanner returns a CLEAN result.
MALWARE_SCANNER="unconfigured"

# =============================================================================
# Analysis providers (wired up in a later phase)
# =============================================================================
# Keep "unconfigured" until a real, authorised provider is connected. The
# platform must never display fabricated similarity or AI-writing results.
SIMILARITY_PROVIDER="unconfigured"
AI_WRITING_PROVIDER="unconfigured"
ANALYSIS_API_BASE_URL=""
ANALYSIS_API_KEY=""
