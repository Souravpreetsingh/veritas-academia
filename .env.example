# Turnint — environment configuration template.
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# `.env.example` is safe to commit because it contains placeholders only.

# =============================================================================
# Database
# =============================================================================
# Local development uses SQLite. Production uses managed PostgreSQL in the same
# region as the services (see docs/deployment-render.md):
#   postgresql://user:password@host:5432/turnint?schema=public&sslmode=require
DATABASE_URL="file:./dev.db"
# Only needed if the provider's connection pooler is enabled (Render PgBouncer
# / Neon pooler). Prisma uses this direct URL for migrations. It is reserved
# until the datasource declares `directUrl`; the app does not read it yet.
# DIRECT_URL=""

# =============================================================================
# Authentication (next-auth v4)
# =============================================================================
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Base URL of this app. Required for correct callback URLs.
NEXTAUTH_URL="http://localhost:3000"
# Public application URL used for absolute links (emails, refunds, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Razorpay (payments)
# =============================================================================
# Server-only credentials. Never prefix these with NEXT_PUBLIC_ — anything
# public is compiled into the browser bundle. The publishable key id is sent to
# the browser only through the authenticated order-creation response.
#
# Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Legacy alias still accepted (prefer RAZORPAY_KEY_SECRET):
# RAZORPAY_SECRET=""
#
# Webhook signing secret (Dashboard -> Account & Settings -> Webhooks). Required
# to accept asynchronous payment events; when unset, the webhook endpoint fails
# closed with 503 and checkout verification remains the only confirmation path.
RAZORPAY_WEBHOOK_SECRET=""

# =============================================================================
# Private document storage
# =============================================================================
# Only "local" is implemented. Documents are stored OUTSIDE /public and are
# reachable exclusively through authorized, ownership-checked routes.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./private-storage"
# Placeholders for a future S3-compatible driver (not implemented).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# =============================================================================
# Malware scanning
# =============================================================================
# "unconfigured" (default) keeps every upload QUARANTINED; it can never be
# downloaded or analysed. "clamav" enables the built-in adapter, which streams
# the exact stored bytes to a clamd daemon over a private TCP connection.
# Any missing setting, timeout, connection failure or malformed response leaves
# the file quarantined. Files are only marked AVAILABLE after a verified CLEAN
# result is persisted and the stored checksum is re-verified.
MALWARE_SCANNER="unconfigured"
# Required when MALWARE_SCANNER="clamav": private-network hostname or IP of the
# daemon. Prefer a private service (e.g. an internal Docker/Render hostname),
# never a public endpoint.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# Total per-file scan budget in milliseconds (1000-60000, default 10000).
# Budget for the largest accepted upload (25 MB) when sizing this.
CLAMAV_TIMEOUT_MS="10000"

# =============================================================================
# Analysis providers
# =============================================================================
# Local corpus similarity is built in and needs no credentials. It compares
# extracted text with a bundled public-domain corpus only; it is NOT internet or
# academic-database plagiarism detection.
#
# Specialist providers remain unconfigured until a real, authorised adapter is
# implemented and registered. With "unconfigured", initiation fails closed with a
# safe error and no result is created; nothing is simulated.
SIMILARITY_PROVIDER="unconfigured"
AI_WRITING_PROVIDER="unconfigured"
ANALYSIS_API_BASE_URL=""
ANALYSIS_API_KEY=""
# `npm run analysis:worker` processes one bounded batch and exits. Schedule the
# command externally (cron/platform job); the web process has no in-memory queue.
ANALYSIS_WORKER_BATCH="10"

# =============================================================================
# LLM-assisted observations (server-only)
# =============================================================================
# Supported provider ids: "openai" (Chat Completions) and "gemini" (Google
# Gemini Interactions API). Leave LLM_PROVIDER="unconfigured" to disable the
# capability. Set an existing model id supported by your account; this
# repository does not invent model ids. For Gemini, a verified stable default
# for structured text analysis is "gemini-3.8-flash" (see docs/analysis.md).
# LLM_EXTERNAL_PROCESSING_ENABLED must be exactly "true" before any document
# text is sent, and the owning student must also grant consent on the request
# page. Never put these values in NEXT_PUBLIC_*.
LLM_PROVIDER="unconfigured"
# OpenAI provider credentials (used only when LLM_PROVIDER="openai"):
LLM_API_KEY=""
LLM_MODEL=""
# Gemini provider credentials (used only when LLM_PROVIDER="gemini"):
GEMINI_API_KEY=""
GEMINI_MODEL=""
LLM_EXTERNAL_PROCESSING_ENABLED="false"
# Optional bounds (clamped server-side).
LLM_TIMEOUT_MS="45000"
LLM_MAX_OUTPUT_TOKENS="1800"

# =============================================================================
# Deployment / trusted proxy (see docs/deployment-render.md)
# =============================================================================
# Client IPs from proxy headers (X-Forwarded-For / X-Real-IP) are recorded in
# audit events AND used as the per-source rate-limit key ONLY when this is
# exactly "true". Leave "false" until the deployed proxy's header behavior has
# been verified with the test in the deployment doc. While disabled, logins and
# registrations share one coarse server-wide source bucket (still bounded, but
# unable to distinguish clients). Proxy headers are spoofable and are never
# used for authorization or payment decisions.
TRUST_PROXY_HEADERS="false"
# Optional server-side secret for hashing rate-limit identifiers. Falls back to
# AUTH_SECRET/NEXTAUTH_SECRET; set it only to rotate limiter keys independently
# of sessions (rotating it resets every active rate-limit window).
RATE_LIMIT_HASH_SECRET=""
