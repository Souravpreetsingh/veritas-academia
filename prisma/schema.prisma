// Turnint / Veritas Academia — Phase 2 foundation schema.
//
// SQLite is used for local development. The schema is written to remain
// PostgreSQL-portable: no SQLite-only behaviour is relied upon.
// See docs/data-model.md for the SQLite -> PostgreSQL migration notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NOTE ON TYPES
//
// Prisma `enum` is not supported on SQLite. Role and status columns are modeled
// as String and constrained with the application-level unions in
// src/lib/domain.ts. On PostgreSQL these columns become native enums.
//
// Prisma `Decimal` is not supported on SQLite. Monetary amounts are stored as
// integer minor units (e.g. paise) plus an ISO-4217 currency code.
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // STUDENT | INSTRUCTOR | ADMIN (see src/lib/domain.ts)
  role         String    @default("STUDENT")
  emailVerified DateTime?
  image        String?

  // Suspension is enforced server-side on every authenticated request.
  suspended       Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studentProfile         StudentProfile?
  instructorProfile      InstructorProfile?
  instructorApplications InstructorApplication[]
  requestsAsStudent      ServiceRequest[]       @relation("StudentRequests")
  documents              Document[]
  analysisJobsRequested  AnalysisJob[]          @relation("RequestedAnalysisJobs")
  auditEvents            AuditEvent[]

  @@index([role])
  @@index([suspended])
  @@map("users")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio         String?
  institution String?
  fieldOfStudy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model InstructorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline String?
  bio      String?
  // JSON-encoded string arrays; upgraded to native JSONB arrays on PostgreSQL.
  expertise       String?
  qualifications String?

  // Only isApproved && isActive instructors may be listed publicly.
  isApproved Boolean @default(false)
  isActive   Boolean @default(true)

  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services InstructorService[]
  requests ServiceRequest[]

  @@index([isApproved, isActive])
  @@map("instructor_profiles")
}

model InstructorApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String
  email         String
  phone         String?
  bio           String
  expertise       String?
  qualifications String?
  // JSON-encoded proposed service offerings (name, description, amountMinor, turnaroundHours).
  proposedServices String?

  termsAcceptedAt DateTime

  // PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED
  status        String    @default("PENDING_REVIEW")
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("instructor_applications")
}

model InstructorService {
  id           String            @id @default(cuid())
  instructorId String
  instructor   InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  code            String
  name            String
  description     String?
  amountMinor     Int
  currency        String          @default("INR")
  turnaroundHours Int
  isActive        Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests ServiceRequest[]

  @@unique([instructorId, code])
  @@index([instructorId, isActive])
  @@map("instructor_services")
}

// Phase 2 records the request core only. Status transitions, payments, analysis
// jobs, reports and disputes arrive with their respective later phases.
model ServiceRequest {
  id        String           @id @default(cuid())
  reference String           @unique
  studentId String
  student   User             @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  serviceId      String
  service        InstructorService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  documents Document[]

  title        String
  instructions String?
  deadlineAt   DateTime?

  // DRAFT | Awaiting Payment | ... (see src/lib/domain.ts)
  status       String @default("DRAFT")
  amountMinor  Int
  currency     String @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([instructorId])
  @@index([status])
  @@map("service_requests")
}

// ---------------------------------------------------------------------------
// Phase 3A — private documents and analysis-provider boundary
// ---------------------------------------------------------------------------

// Document METADATA only. File contents live in private storage (see
// src/lib/storage); this table stores a storage reference and metadata so the
// database is never used to hold uploaded file bytes.
model Document {
  id      String  @id @default(cuid())
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // A document may belong to a request; deleting the request keeps the record
  // but detaches it rather than destroying evidence.
  requestId String?
  request   ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  storageDriver  String  @default("local")
  storageKey     String  @unique
  originalName   String
  contentType    String
  sizeBytes      Int
  checksumSha256 String?

  // AVAILABLE | QUARANTINED | DELETED (see src/lib/domain.ts)
  status String @default("AVAILABLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisJobs AnalysisJob[]

  @@index([ownerId])
  @@index([requestId])
  @@index([status])
  @@map("documents")
}

// A unit of analysis work against a document. Until a real, authorised provider
// is connected, jobs remain UNCONFIGURED and are never marked COMPLETED.
model AnalysisJob {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User     @relation("RequestedAnalysisJobs", fields: [requestedById], references: [id], onDelete: Cascade)

  // SIMILARITY | AI_WRITING
  type   String
  // UNCONFIGURED | PENDING | PROCESSING | COMPLETED | FAILED
  status String @default("UNCONFIGURED")

  // Provider integration boundary. Defaults to "unconfigured".
  provider      String  @default("unconfigured")
  providerJobId String?
  // JSON-encoded provider metadata. Never store raw document text here.
  providerMeta  String?

  errorMessage String?
  attempts     Int      @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result AnalysisResult?

  @@index([documentId])
  @@index([status])
  @@index([type])
  @@map("analysis_jobs")
}

// Results are written ONLY by a real analysis provider. Score fields are
// nullable by design: null means "not produced" — never a fabricated zero.
model AnalysisResult {
  id    String      @id @default(cuid())
  jobId String      @unique
  job   AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // UNCONFIGURED | PENDING | PROCESSING | COMPLETED | FAILED
  status String

  similarityPercent Float?
  aiLikelihood      Float?

  // JSON-encoded matched sources / segments. Null until a real provider runs.
  matches         String?
  providerPayload String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("analysis_results")
}

// ---------------------------------------------------------------------------
// Phase 3B — security audit trail and quarantine
// ---------------------------------------------------------------------------

// Append-only record of security-relevant events (sensitive document access,
// denials, uploads). Never stores document contents, passwords, or tokens.
// `actorId` is nullable with SetNull so the trail survives user deletion.
model AuditEvent {
  id      String @id @default(cuid())
  actorId String?
  actor   User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // e.g. "document.upload", "document.download", "document.download.denied"
  action     String
  targetType String?
  targetId   String?
  // JSON-encoded, non-sensitive context only.
  metadata   String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}
